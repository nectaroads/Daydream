@echo off
setlocal enableextensions disabledelayedexpansion
set "DAYDREAM_UPDATE_PLAN_VERSION=2"
cd /d "%~dp0"
set "DAYDREAM_PATCH_ROOT=%~dp0"
set "DAYDREAM_PATCH_PID=%~1"
set "DAYDREAM_PATCH_MODE=%~2"
powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -Command ^
 "$ErrorActionPreference='Stop'; function Test-UpdateFile($path,$sha,$size) { if (-not (Test-Path -LiteralPath $path -PathType Leaf)) { return $false }; if ((Get-Item -LiteralPath $path).Length -ne $size) { return $false }; $stream=[IO.File]::OpenRead($path); $hash=[Security.Cryptography.SHA1]::Create(); try { $header=[Text.Encoding]::UTF8.GetBytes(('blob '+$size)+[char]0); [void]$hash.TransformBlock($header,0,$header.Length,$header,0); $buffer=New-Object byte[] 262144; while (($read=$stream.Read($buffer,0,$buffer.Length)) -gt 0) { [void]$hash.TransformBlock($buffer,0,$read,$buffer,0) }; [void]$hash.TransformFinalBlock((New-Object byte[] 0),0,0); return ([BitConverter]::ToString($hash.Hash).Replace('-','').ToLowerInvariant() -eq $sha) } finally { $stream.Dispose(); $hash.Dispose() } }; try { $root=[IO.Path]::GetFullPath($env:DAYDREAM_PATCH_ROOT).TrimEnd([char]92)+[char]92; $gamePid=0; if ($env:DAYDREAM_PATCH_PID) { if (-not [int]::TryParse($env:DAYDREAM_PATCH_PID,[ref]$gamePid) -or $gamePid -le 0) { throw 'Invalid game process ID' }; if (Get-Process -Id $gamePid -ErrorAction SilentlyContinue) { Wait-Process -Id $gamePid -ErrorAction SilentlyContinue } }; $plan=Join-Path $root '.daydream-update-plan.json'; $hasPlan=Test-Path -LiteralPath $plan; if ($hasPlan) { $update=Get-Content -LiteralPath $plan -Raw | ConvertFrom-Json; if ($update.files) { $entries=$update.files } else { $entries=$update } } else { $entries=@(@{path='aLogin.exe'},@{path='aLogin.pck'}) }; $files=@(); foreach ($entry in $entries) { $relative=[string]$entry.path; $parts=$relative.Split('/'); if (-not $relative -or $relative.Contains('\') -or $relative.Contains(':') -or $relative.StartsWith('/') -or @($parts | Where-Object { $_ -in @('','.','..') -or $_.EndsWith('.') -or $_.EndsWith(' ') }).Count) { throw 'Invalid update path' }; if ($relative -notin @('aLogin.exe','aLogin.pck') -and -not ($parts.Length -gt 1 -and $parts[0] -in @('assets','data','jma','sounds','cutscenes'))) { throw 'Unsupported update path' }; $target=[IO.Path]::GetFullPath((Join-Path $root $relative)); if (-not $target.StartsWith($root,[StringComparison]::OrdinalIgnoreCase)) { throw 'Update path is outside game folder' }; $current=$root; foreach ($part in $parts) { $current=Join-Path $current $part; if ((Test-Path -LiteralPath $current) -and ((Get-Item -LiteralPath $current -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Update path is a link' } }; $source=$target+'.tmp'; if ((Test-Path -LiteralPath $source) -and ((Get-Item -LiteralPath $source -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Update source is a link' }; if ($entry.sha -and ($entry.sha -notmatch '^[0-9a-f]{40}$' -or [long]$entry.size -lt 0)) { throw ('Invalid file integrity metadata '+$relative) }; $files+=@{source=$source;target=$target;path=$relative;sha=$entry.sha;size=[long]$entry.size} }; foreach ($file in $files) { if (-not (Test-Path -LiteralPath $file.source)) { if ($hasPlan -and (-not (Test-Path -LiteralPath $file.target) -or ($file.sha -and -not (Test-UpdateFile $file.target $file.sha $file.size)))) { throw ('Missing or unapplied update file '+$file.path+'. Open the game to retry the update.') }; continue }; if ($file.sha -and -not (Test-UpdateFile $file.source $file.sha $file.size)) { throw ('Damaged update file '+$file.path+'. Open the game to retry the update.') }; $applied=$false; for ($attempt=0; $attempt -lt 30; $attempt++) { try { Move-Item -LiteralPath $file.source -Destination $file.target -Force; $applied=$true; break } catch { Start-Sleep -Milliseconds 500 } }; if (-not $applied) { throw ('Cannot replace '+$file.path+'. Close other game clients and run patcher.bat again.') } }; if ($hasPlan) { if ($update.complete -eq $true -and $update.revision -match '^[0-9a-f]{40}$') { $version=@{repository=$update.repository;branch=$update.branch;revision=$update.revision} | ConvertTo-Json -Compress; [IO.File]::WriteAllText((Join-Path $root '.daydream-update-version.json'),$version,(New-Object Text.UTF8Encoding($false))) }; Remove-Item -LiteralPath $plan -Force }; if ($env:DAYDREAM_PATCH_MODE -ne '--no-restart') { Start-Process -FilePath (Join-Path $root 'aLogin.exe') -WorkingDirectory $root }; exit 0 } catch { $_ | Out-String | Set-Content -LiteralPath (Join-Path $env:DAYDREAM_PATCH_ROOT 'patcher-error.log'); exit 1 }"
exit /b %errorlevel%
